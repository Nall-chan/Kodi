        "        KODISYS_Shutdown($_IPS['TARGET']);",
        "        break;",
        "    case 'Reboot':",
        "        KODISYS_Reboot($_IPS['TARGET']);",
        "        break;",
        "    case 'Suspend':",
        "        KODISYS_Suspend($_IPS['TARGET']);",
        "        break;",
        "    case 'Hibernate':",
        "        KODISYS_Hibernate($_IPS['TARGET']);",
        "        break;",
        "    case 'EjectOpticalDrive':",
        "        KODISYS_EjectOpticalDrive($_IPS['TARGET']);",
        "        break;",
        "}"
